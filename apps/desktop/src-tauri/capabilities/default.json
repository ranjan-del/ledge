{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Ledge windows: read, write and watch the store under $HOME/.ledge, list folders under $HOME to find repositories, run git status, and launch a terminal.",
  "windows": [
    "button",
    "panel"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-current-monitor",
    "core:window:allow-scale-factor",
    "core:window:allow-is-visible",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "os:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/.ledge"
        },
        {
          "path": "$HOME/.ledge/*"
        },
        {
          "path": "$HOME/.ledge/**"
        },
        {
          "path": "$HOME/.ledge/.scan-cache.json"
        },
        {
          "path": "$HOME"
        },
        {
          "path": "$HOME/*"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$HOME/.git"
        },
        {
          "path": "$HOME/*/.git"
        },
        {
          "path": "$HOME/**/.git"
        },
        {
          "path": "$HOME/.claude"
        },
        {
          "path": "$HOME/.claude/projects"
        },
        {
          "path": "$HOME/.claude/projects/*"
        },
        {
          "path": "$HOME/.claude/projects/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$HOME/.ledge"
        },
        {
          "path": "$HOME/.ledge/*"
        },
        {
          "path": "$HOME/.ledge/**"
        },
        {
          "path": "$HOME/.ledge/.scan-cache.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$HOME/.ledge"
        },
        {
          "path": "$HOME/.ledge/*"
        },
        {
          "path": "$HOME/.ledge/**"
        },
        {
          "path": "$HOME/.ledge/.scan-cache.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$HOME/.ledge"
        },
        {
          "path": "$HOME/.ledge/*"
        },
        {
          "path": "$HOME/.ledge/**"
        },
        {
          "path": "$HOME/.ledge/.scan-cache.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$HOME/.ledge"
        },
        {
          "path": "$HOME/.ledge/*"
        },
        {
          "path": "$HOME/.ledge/**"
        },
        {
          "path": "$HOME/.ledge/.scan-cache.json"
        },
        {
          "path": "$HOME"
        },
        {
          "path": "$HOME/*"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$HOME/.git"
        },
        {
          "path": "$HOME/*/.git"
        },
        {
          "path": "$HOME/**/.git"
        }
      ]
    },
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$HOME/.ledge"
        },
        {
          "path": "$HOME/.ledge/*"
        },
        {
          "path": "$HOME/.ledge/**"
        },
        {
          "path": "$HOME/.ledge/.scan-cache.json"
        },
        {
          "path": "$HOME"
        },
        {
          "path": "$HOME/*"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$HOME/.claude"
        },
        {
          "path": "$HOME/.claude/projects"
        },
        {
          "path": "$HOME/.claude/projects/*"
        },
        {
          "path": "$HOME/.claude/projects/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "$HOME/.ledge"
        },
        {
          "path": "$HOME/.ledge/*"
        },
        {
          "path": "$HOME/.ledge/**"
        },
        {
          "path": "$HOME/.ledge/.scan-cache.json"
        },
        {
          "path": "$HOME/**/.git/index"
        },
        {
          "path": "$HOME/*/.git/index"
        },
        {
          "path": "$HOME/.git/index"
        },
        {
          "path": "$HOME/.claude"
        },
        {
          "path": "$HOME/.claude/projects"
        },
        {
          "path": "$HOME/.claude/projects/*"
        },
        {
          "path": "$HOME/.claude/projects/**"
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "git",
          "cmd": "git",
          "args": [
            "-C",
            {
              "validator": "[^\\r\\n]+"
            },
            "status",
            "--porcelain=v2",
            "--branch"
          ]
        },
        {
          "name": "osascript",
          "cmd": "osascript",
          "args": [
            "-e",
            {
              "validator": "[\\s\\S]+"
            },
            "-e",
            {
              "validator": "[\\s\\S]+"
            }
          ]
        },
        {
          "name": "wt",
          "cmd": "wt",
          "args": [
            "-d",
            {
              "validator": "[^\\r\\n]+"
            },
            "cmd",
            "/k",
            {
              "validator": "[\\s\\S]+"
            }
          ]
        },
        {
          "name": "x-terminal-emulator",
          "cmd": "x-terminal-emulator",
          "args": [
            "-e",
            "sh",
            "-c",
            {
              "validator": "[\\s\\S]+"
            }
          ]
        }
      ]
    },
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
