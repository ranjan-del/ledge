{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Ledge windows: read, write and watch the store under $HOME/.ledge, list folders under $HOME to find repositories, run git status, and launch a terminal, run the assistant as one long-lived Claude Code process over stdin and stdout, and print a resume brief.",
  "windows": [
    "button",
    "panel"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-current-monitor",
    "core:window:allow-scale-factor",
    "core:window:allow-is-visible",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "os:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/.ledge"
        },
        {
          "path": "$HOME/.ledge/*"
        },
        {
          "path": "$HOME/.ledge/**"
        },
        {
          "path": "$HOME/.ledge/.scan-cache.json"
        },
        {
          "path": "$HOME/.ledge/.news.json"
        },
        {
          "path": "$HOME"
        },
        {
          "path": "$HOME/*"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$HOME/.git"
        },
        {
          "path": "$HOME/*/.git"
        },
        {
          "path": "$HOME/**/.git"
        },
        {
          "path": "$HOME/.claude"
        },
        {
          "path": "$HOME/.claude/projects"
        },
        {
          "path": "$HOME/.claude/projects/*"
        },
        {
          "path": "$HOME/.claude/projects/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$HOME/.ledge"
        },
        {
          "path": "$HOME/.ledge/*"
        },
        {
          "path": "$HOME/.ledge/**"
        },
        {
          "path": "$HOME/.ledge/.scan-cache.json"
        },
        {
          "path": "$HOME/.ledge/.news.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$HOME/.ledge"
        },
        {
          "path": "$HOME/.ledge/*"
        },
        {
          "path": "$HOME/.ledge/**"
        },
        {
          "path": "$HOME/.ledge/.scan-cache.json"
        },
        {
          "path": "$HOME/.ledge/.news.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$HOME/.ledge"
        },
        {
          "path": "$HOME/.ledge/*"
        },
        {
          "path": "$HOME/.ledge/**"
        },
        {
          "path": "$HOME/.ledge/.scan-cache.json"
        },
        {
          "path": "$HOME/.ledge/.news.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$HOME/.ledge"
        },
        {
          "path": "$HOME/.ledge/*"
        },
        {
          "path": "$HOME/.ledge/**"
        },
        {
          "path": "$HOME/.ledge/.scan-cache.json"
        },
        {
          "path": "$HOME/.ledge/.news.json"
        },
        {
          "path": "$HOME"
        },
        {
          "path": "$HOME/*"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$HOME/.git"
        },
        {
          "path": "$HOME/*/.git"
        },
        {
          "path": "$HOME/**/.git"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$HOME/.ledge"
        },
        {
          "path": "$HOME/.ledge/*"
        },
        {
          "path": "$HOME/.ledge/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        {
          "path": "$HOME/.ledge"
        },
        {
          "path": "$HOME/.ledge/*"
        },
        {
          "path": "$HOME/.ledge/**"
        }
      ]
    },
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$HOME/.ledge"
        },
        {
          "path": "$HOME/.ledge/*"
        },
        {
          "path": "$HOME/.ledge/**"
        },
        {
          "path": "$HOME/.ledge/.scan-cache.json"
        },
        {
          "path": "$HOME/.ledge/.news.json"
        },
        {
          "path": "$HOME"
        },
        {
          "path": "$HOME/*"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$HOME/.claude"
        },
        {
          "path": "$HOME/.claude/projects"
        },
        {
          "path": "$HOME/.claude/projects/*"
        },
        {
          "path": "$HOME/.claude/projects/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "$HOME/.ledge"
        },
        {
          "path": "$HOME/.ledge/*"
        },
        {
          "path": "$HOME/.ledge/**"
        },
        {
          "path": "$HOME/.ledge/.scan-cache.json"
        },
        {
          "path": "$HOME/.ledge/.news.json"
        },
        {
          "path": "$HOME/**/.git/index"
        },
        {
          "path": "$HOME/*/.git/index"
        },
        {
          "path": "$HOME/.git/index"
        },
        {
          "path": "$HOME/.claude"
        },
        {
          "path": "$HOME/.claude/projects"
        },
        {
          "path": "$HOME/.claude/projects/*"
        },
        {
          "path": "$HOME/.claude/projects/**"
        },
        {
          "path": "$HOME/*"
        },
        {
          "path": "$HOME/**"
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "git",
          "cmd": "git",
          "args": [
            "-C",
            {
              "validator": "[^\\r\\n]+"
            },
            "status",
            "--porcelain=v2",
            "--branch"
          ]
        },
        {
          "name": "osascript",
          "cmd": "osascript",
          "args": [
            "-e",
            {
              "validator": "[\\s\\S]+"
            },
            "-e",
            {
              "validator": "[\\s\\S]+"
            }
          ]
        },
        {
          "name": "wt",
          "cmd": "wt",
          "args": [
            "-d",
            {
              "validator": "[^\\r\\n]+"
            },
            "cmd",
            "/k",
            {
              "validator": "[\\s\\S]+"
            }
          ]
        },
        {
          "name": "x-terminal-emulator",
          "cmd": "x-terminal-emulator",
          "args": [
            "-e",
            "sh",
            "-c",
            {
              "validator": "[\\s\\S]+"
            }
          ]
        },
        {
          "name": "git-ls-files",
          "cmd": "git",
          "args": [
            "-C",
            {
              "validator": "[^\\r\\n]+"
            },
            "ls-files",
            "-z"
          ]
        },
        {
          "name": "ledge-brief",
          "cmd": "/bin/sh",
          "args": [
            "-c",
            "PATH=\"$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\"; export PATH LEDGE_CAPTURE=1; command -v ledge >/dev/null 2>&1 || exit 127; exec ledge brief \"$1\"",
            "ledge-brief",
            {
              "validator": "[A-Za-z0-9][A-Za-z0-9._-]*"
            }
          ]
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "claude-agent",
          "cmd": "/bin/sh",
          "args": [
            "-c",
            "PATH=\"$HOME/.local/bin:$HOME/.claude/local:/opt/homebrew/bin:/usr/local/bin:$PATH\"; export PATH LEDGE_CAPTURE=1; command -v claude >/dev/null 2>&1 || exit 127; cd \"$HOME/.ledge\" 2>/dev/null || cd \"$HOME\"; sp=\"$2\"; if [ -r \"$HOME/.claude/identity.md\" ]; then sp=\"$sp\n\nWho the person is, from ~/.claude/identity.md:\n$(cat \"$HOME/.claude/identity.md\")\"; fi; exec claude -p --input-format stream-json --output-format stream-json --verbose --include-partial-messages --permission-prompt-tool stdio --permission-mode default --model \"$1\" --append-system-prompt \"$sp\" ${3:+--resume \"$3\"}",
            "ledge-assistant",
            {
              "validator": "(haiku|sonnet|opus)"
            },
            {
              "validator": "[\\s\\S]+"
            },
            {
              "validator": "([0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})?"
            }
          ]
        }
      ]
    },
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
